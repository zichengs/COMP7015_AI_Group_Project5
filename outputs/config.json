      "Tomato___healthy": "Tomato leaf",
      "Tomato___Bacterial_spot": "Tomato leaf bacterial spot",
      "Tomato___Early_blight": "Tomato Early blight leaf",
      "Tomato___Late_blight": "Tomato leaf late blight"
    }
  },
  "train": {
    "seeds": [
      62,
      63,
      64
    ],
    "swap_prob": 0.5
  }
}